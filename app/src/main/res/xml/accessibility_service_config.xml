<?xml version="1.0" encoding="utf-8"?>
<!-- flagInputMethodEditor (Android 13+) makes Android attach the service's own
     input method next to the real keyboard: onStartInput/onFinishInput drive the
     button, and commitText inserts at the cursor (PLAN §4.1, §4.6).
     Window events feed the keyboard-visible check; text-changed events only
     re-check the text box's size (its text is never read).
     Key events: only volume up is looked at, for the double press that starts
     a voice note (PLAN §4.11); everything else passes straight through. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowsChanged|typeWindowStateChanged|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagInputMethodEditor|flagRetrieveInteractiveWindows|flagRequestFilterKeyEvents"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="50"
    android:description="@string/accessibility_description" />
