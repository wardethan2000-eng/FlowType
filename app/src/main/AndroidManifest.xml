<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- One tap to Battery → Unrestricted, so One UI doesn't put the service to sleep. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- App names in History: see apps with a launcher icon. -->
    <queries>
        <package android:name="com.google.android.keep" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- allowBackup off: the Keystore-wrapped API key must not reach a cloud
         backup or Smart Switch (PLAN §4.9). -->
    <application
        android:name=".FlowtypeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flowtype">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ModelsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.DictionaryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.CleanupSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ButtonSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.NotesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.DeveloperActivity"
            android:exported="false" />

        <!-- The bench runs in its own process, so the RAM it measures is the
             model's and not the dictation service's. Exported so it can be
             started with `adb shell am start` for unattended runs. -->
        <activity
            android:name=".ui.BenchActivity"
            android:exported="true"
            android:process=":bench"
            android:label="@string/bench_title" />

        <activity
            android:name=".ui.InsertionTestActivity"
            android:exported="false"
            android:label="@string/insertion_test_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.CleanupTestActivity"
            android:exported="false"
            android:label="@string/cleanup_test_title"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".service.DictationService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
